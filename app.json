{
  "expo": {
    "name": "meuAppLembrete",
    "slug": "meuAppLembrete",
    "scheme": "meuapplembrete",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/sua-logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/sua-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/images/sua-logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar"
    ]
  }
}
